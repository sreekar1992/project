# Development-only example. Replace every placeholder with a unique secret.
# Never commit your populated .env file or reuse these values for real care.
POSTGRES_DB=ecg_platform
POSTGRES_USER=ecg_platform
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_SECRET

SECRET_KEY=REPLACE_WITH_A_RANDOM_48_CHARACTER_SECRET
JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_48_CHARACTER_SECRET

# Optional local-development path for the AES-256-GCM clinical-asset key.
# The default is the ignored var/clinical_asset_key.bin file with mode 0600.
# Use KMS/HSM-backed object storage rather than a local key file in production.
# LOCAL_ASSET_ENCRYPTION_KEY_PATH=/absolute/private/path/clinical_asset_key.bin

MINIO_ROOT_USER=REPLACE_WITH_A_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_MINIO_SECRET_OF_AT_LEAST_8_CHARACTERS
OBJECT_STORAGE_BUCKET=ecg-clinical-private

# Must correspond to the verified local checkpoint mounted at artifacts_final/model.pt.
AI_MODEL_VERSION=local-research-checkpoint
