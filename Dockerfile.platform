# syntax=docker/dockerfile:1
# Separate image for the authenticated ECG health-platform API.  The legacy
# workbench remains in Dockerfile and is not exposed by this image.
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY migrations ./migrations

# CPU wheels are appropriate for the request-serving API.  Train accelerator
# models in a dedicated, separately governed job image.
RUN python -m pip install --upgrade pip \
    && python -m pip install --extra-index-url https://download.pytorch.org/whl/cpu .

RUN groupadd --gid 10001 ecg \
    && useradd --uid 10001 --gid ecg --create-home --shell /usr/sbin/nologin ecg \
    && mkdir -p /tmp/matplotlib \
    && chown -R 10001:10001 /tmp/matplotlib /app

USER 10001:10001
EXPOSE 8080

CMD ["gunicorn", "--bind=0.0.0.0:8080", "--workers=2", "--threads=4", "--timeout=120", "--worker-tmp-dir=/tmp", "--access-logfile=-", "--error-logfile=-", "ecg_cvd.clinical.wsgi:app"]
